# aggressive = Groq 429 → falla rápido y polish/fallback puede usar Gemini; conservative = más reintentos Groq
FALLBACK_STRATEGY="aggressive"
GROQ_AGGRESSIVE_MAX_WAVES="1"
# Tras Groq vacío en fallback: 1 = intentar Gemini aunque no sea aggressive (consume cuota Gemini)
