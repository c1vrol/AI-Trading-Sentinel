# --- Stack “gratis primero” (Groq polish + alertas; Grok opcional) ---
PREFER_GROQ_FOR_POLISH="true"
# free = solo Groq barato; premium = tras Groq puede pasar segunda capa Grok (si GROK_ENABLED)
