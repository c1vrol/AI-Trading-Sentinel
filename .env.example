# Archivo de configuración de variables de entorno

# ================================
# CONFIGURACIÓN DE DISCORD
# ================================
# Tu token generado en el portal de desarrolladores de Discord
DISCORD_BOT_TOKEN="tu_token_aqui"

# Candado SaaS: ID de los Canales VIP autorizados (separados por comas)
# El bot no enviará alertas ni responderá comandos fuera de estos canales
ALLOWED_CHANNEL_IDS="123456789,987654321"

# Canal principal donde se enviarán las alertas por defecto (Opcional, según lógica de main.py)
ALERT_CHANNEL_ID="123456789"

# ================================
# API KEYS DE INTELIGENCIA ARTIFICIAL
# ================================
# Clave para usar el modelo generativo de Google Gemini
GEMINI_API_KEY="tu_clave_gemini_aqui"

# ================================
# OTRAS CONFIGURACIONES
# ================================
LOG_LEVEL="INFO"
