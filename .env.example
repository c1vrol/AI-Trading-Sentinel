# Forzar rescate a Groq si Gemini falla (1=on, 0=off)
FALLBACK_TO_GROQ="1"
# Si gemini no está en POLISH_PREFERENCE_ORDER: 1/0 fuerza puente tras fallo Groq; vacío = aggressive→sí, conservative→no
